# Fictional local-only credentials. Copy to .env; never use in production.
POSTGRES_USER=n5deal
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=n5deal_demo
DATABASE_URL=postgresql://n5deal:local-demo-only@db:5432/n5deal_demo
# Deliberately disabled. Enable only for the explicit reset-demo command.
LOCAL_DEMO_RESET=false
# Required for demo sessions. Generate a random secret (at least 32 bytes):
# docker compose run --rm app node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Local HTTP: false. Set true when serving the app over HTTPS.
SESSION_COOKIE_SECURE=false
