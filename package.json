{
  "name": "n5deal-marketplace-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test:auth": "node --conditions=react-server --import tsx --test scripts/auth.test.ts",
    "test:marketplace": "node --conditions=react-server --import tsx --test scripts/assets.test.ts scripts/buyers.test.ts",
    "test:catalogs": "node --conditions=react-server --import tsx --test scripts/catalogs.test.ts",
    "test:inquiries": "node --conditions=react-server --import tsx --test scripts/inquiries.test.ts",
    "test:moderation": "node --conditions=react-server --import tsx --test scripts/moderation.test.ts",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "verify:fixtures": "tsx scripts/verify-fixtures.ts",
    "verify:local-db": "tsx scripts/verify-local-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.3",
    "jose": "6.2.12",
    "next": "16.3.8",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
